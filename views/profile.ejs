<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile — SocialHub</title>
    <link rel="stylesheet" href="/styles/main.css">
</head>
<body>

<nav class="navbar">
    <div class="logo"><a href="/">SocialHub</a></div>
</nav>

<div class="profile-container">

    <div class="cover-photo"></div>

    <div class="profile-card">

        <img src="https://via.placeholder.com/150" class="profile-pic">

        <h2>John Doe</h2>

        <p>Web Developer | Coffee Lover ☕</p>

        <button>Edit Profile</button>

    </div>

    <div class="profile-posts">

        <h3>Recent Posts</h3>

        <div class="post">
            <p>Just finished my new website 🚀</p>
        </div>

        <div class="post">
            <p>Learning Node.js today!</p>
        </div>

    </div>

</div>

</body>
</html>
